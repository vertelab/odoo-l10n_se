<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
        Static partner records (kept for backward compatibility).
        The main demo data (taxes, products, invoices, periodic
        compilation) is generated by generate_demo_data() below.
        ============================================================ -->

        <record id="partner_eu_france" model="res.partner">
            <field name="name">Camptocamp France SAS</field>
            <field name="is_company" eval="True"/>
            <field name="country_id" ref="base.fr"/>
            <field name="city">Paris</field>
            <field name="street">8 Rue de la Bourse</field>
            <field name="zip">75002</field>
            <field name="vat">FR23334175221</field>
        </record>

        <record id="partner_eu_germany" model="res.partner">
            <field name="name">Handel GmbH</field>
            <field name="is_company" eval="True"/>
            <field name="country_id" ref="base.de"/>
            <field name="city">Berlin</field>
            <field name="street">Hauptstraße 42</field>
            <field name="zip">10115</field>
            <field name="vat">DE987654321</field>
        </record>

        <record id="partner_non_eu" model="res.partner">
            <field name="name">Global Trading Inc</field>
            <field name="is_company" eval="True"/>
            <field name="country_id" ref="base.us"/>
            <field name="city">New York</field>
            <field name="street">5th Avenue 100</field>
            <field name="zip">10001</field>
        </record>

        <!-- ============================================================
        Generate EU taxes, invoices, and periodic compilation.
        Calls PeriodicCompilationDemo.generate_demo_data() which:
        - Creates VTEU/FTEU/3FEU/E tax records
        - Creates 2 additional EU partners (NL, DK)
        - Creates 4 products with EU taxes
        - Creates 6 outgoing invoices to EU customers
        - Creates and calculates 1 periodic compilation
        ============================================================ -->
        <function model="l10n_se_tax_report.periodic_compilation_demo" name="generate_demo_data"/>

    </data>
</odoo>
