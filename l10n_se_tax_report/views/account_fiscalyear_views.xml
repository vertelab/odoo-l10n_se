<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_account_fiscalyear_form" model="ir.ui.view">
            <field name="name">account.fiscalyear.form</field>
            <field name="model">account.fiscalyear</field>
            <field name="inherit_id" ref="account_period_vrtl.view_account_fiscalyear_form"/>
            <field name="arch" type="xml">
                <button name="create_balance" position="after">
                    <button name="action_generate_tax_declaration" type="object" string="Generate Tax Declaration" class="btn btn-primary" />
                </button>
                <xpath expr="//notebook/page[@name='period']" position="after">
                    <page string="Tax Declaration" name="tax_declaration">
                        <group>
                            <group>
                                <field name="vat_declaration_frequency"/>
                                <field name="accounting_method"/>
                            </group>
                            <group>
                                <field name="moms_journal"/>
                            </group>
                            <field name="tax_declaration_ids" nolabel="1" invisible="not tax_declaration_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_stop"/>
                                    <field name="date" string="Declaration Date"/>
                                    <field name="state"/>
                                    <button name="show_mis_report" type="object" string="Show Report" class="btn btn-primary" />
                                    <button name="calculate" type="object" string="Beräkna" class="btn btn-primary" />
                                </list>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>