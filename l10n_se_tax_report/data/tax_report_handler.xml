<?xml version="1.0" encoding="utf-8"?>
<!--
    Point the Swedish VAT boxes at account.se.tax.report.handler.

    The core report (l10n_se) computes every box from tax tags. That is correct
    for the taxes Odoo SA ships, but blind to the taxes l10n_se_extended adds
    (MP1, MP2, MP3, I, MU1, MBBU, MPFF, TFEU/VFEU...): those have empty
    tag_ids and post to 2610/2620/2630/2640 instead of 2611/2621/2641.
    Measured 2026-11-09: MIS reported 5 000 kr in box 10 and account.report
    reported 0 for the same invoice.

    The handler selects by tax name AND by tag, so both chart populations are
    covered and a database carrying both is not double-counted.

    Only boxes whose tax population includes extended-chart taxes are
    re-pointed. Boxes the core chart fully covers keep using tax_tags, so this
    file stays small and the change is auditable.
-->
<odoo>
    <data>
        <!-- Box 05: base amount of taxable domestic sales -->
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_05_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval_base', 'subformula': 'se_05'}"/>
        </function>

        <!-- Box 10 / 11 / 12: outgoing VAT 25 / 12 / 6 % -->
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_10_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_10'}"/>
        </function>
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_11_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_11'}"/>
        </function>
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_12_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_12'}"/>
        </function>

        <!-- Box 30 / 31 / 32: outgoing VAT, reverse charge -->
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_30_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_30'}"/>
        </function>
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_31_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_31'}"/>
        </function>
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_32_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_32'}"/>
        </function>

        <!-- Box 48: incoming VAT, including the extended chart I/I6/IVIS/ITIS taxes -->
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_48_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_48'}"/>
        </function>

        <!-- Box 60 / 61 / 62: import VAT -->
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_60_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_60'}"/>
        </function>
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_61_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_61'}"/>
        </function>
        <function model="account.report.expression" name="write">
            <value model="account.report.expression" search="[('id', '=', ref('l10n_se.tax_report_line_62_tag'))]"/>
            <value eval="{'engine': 'custom', 'formula': '_custom_expression_eval', 'subformula': 'se_62'}"/>
        </function>

        <!-- Put the handler on the core report so expressions can find it. -->
        <record id="l10n_se.tax_report" model="account.report">
            <field name="custom_handler_model_id"
                   ref="model_account_se_tax_report_handler"/>
        </record>
    </data>
</odoo>
