#. module: l10n_se_currency_riksbank
#: model:ir.model,name:l10n_se_currency_riksbank.model_res_currency_rate_provider
msgid "Currency Rates Provider"
msgstr "Leverantör av valutakurser"

#. module: l10n_se_currency_riksbank
#: code:addons/l10n_se_currency_riksbank/models/res_currency_rate_provider_riksbank.py:0
#, python-format
msgid ""
"Riksbank does not publish a rate for the company currency %(currency)s. "
"Set up the provider on a company whose currency is SEK, or pick another "
"provider."
msgstr ""
"Riksbanken publicerar ingen kurs för företagets valuta %(currency)s. Sätt "
"upp leverantören på ett företag med SEK som valuta, eller välj en annan "
"leverantör."

#. module: l10n_se_currency_riksbank
#: code:addons/l10n_se_currency_riksbank/models/res_currency_rate_provider_riksbank.py:0
#, python-format
msgid "Invalid Riksbank series name: %(series)s"
msgstr "Ogiltigt serienamn från Riksbanken: %(series)s"

#. module: l10n_se_currency_riksbank
#: code:addons/l10n_se_currency_riksbank/models/res_currency_rate_provider_riksbank.py:0
#, python-format
msgid "Could not reach Riksbank: %(error)s"
msgstr "Kunde inte nå Riksbanken: %(error)s"

#. module: l10n_se_currency_riksbank
#: code:addons/l10n_se_currency_riksbank/models/res_currency_rate_provider_riksbank.py:0
#, python-format
msgid "Riksbank answered %(status)s for %(url)s"
msgstr "Riksbanken svarade %(status)s för %(url)s"

#. module: l10n_se_currency_riksbank
#: code:addons/l10n_se_currency_riksbank/models/res_currency_rate_provider_riksbank.py:0
#, python-format
msgid ""
"Riksbank kept answering 429 Too Many Requests for %(url)s after %(attempts)s "
"attempts. Try again later."
msgstr ""
"Riksbanken svarade fortsatt 429 Too Many Requests för %(url)s efter "
"%(attempts)s försök. Försök igen senare."
