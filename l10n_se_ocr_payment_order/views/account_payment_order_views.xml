<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_order_form_inherit_ocr" model="ir.ui.view">
        <field name="name">account.payment.order.form.inherit.ocr</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payment-lines']//field[@name='payment_line_ids']" position="inside">
                <list>
                    <field name="partner_id"/>
                    <field name="communication"/>
                    <field name="ocr_number" optional="show"/>
                    <field name="partner_bank_id"/>
                    <field name="amount_currency" sum="Total amount"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="date"/>
                </list>
            </xpath>
        </field>
    </record>
</odoo>
