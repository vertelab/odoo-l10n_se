<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="print_account_payment_order_document_inherit_ocr"
              inherit_id="account_payment_order.print_account_payment_order_document">
        <xpath expr="//table[contains(@class, 'o_main_table')]/thead/tr" position="inside">
            <th class="text-center">OCR Number</th>
        </xpath>
        <xpath expr="//table[contains(@class, 'o_main_table')]/tbody/tr" position="inside">
            <td class="text-center">
                <span t-if="line.ocr_number" t-field="line.ocr_number"/>
            </td>
        </xpath>
    </template>
</odoo>
