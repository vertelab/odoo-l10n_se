<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_statement_line_form_inherit_ocr" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.inherit.ocr</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_statement_base.account_bank_statement_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ref']" position="after">
                <field name="extracted_ocr"
                       readonly="1"
                       class="oe_inline"
                       invisible="not extracted_ocr"/>
            </xpath>
        </field>
    </record>

    <record id="view_bank_statement_line_tree_inherit_ocr" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.inherit.ocr</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_statement_base.account_bank_statement_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ref']" position="after">
                <field name="extracted_ocr" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_bank_statement_line_search_inherit_ocr" model="ir.ui.view">
        <field name="name">account.bank.statement.line.search.inherit.ocr</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_statement_base.account_bank_statement_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="has_ocr"
                        string="Has Extracted OCR"
                        domain="[('extracted_ocr', '!=', False)]"/>
                <filter name="no_ocr"
                        string="No Extracted OCR"
                        domain="[('extracted_ocr', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- 4-Pass Reconciliation Button on Bank Statement -->
    <record id="view_bank_statement_form_inherit_4pass" model="ir.ui.view">
        <field name="name">account.bank.statement.form.inherit.4pass</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account_statement_base.view_bank_statement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_4pass_reconcile" string="4-Pass Auto-Reconcile"
                        type="object" class="oe_stat_button" icon="fa-magic"
                        help="Run 4-pass greedy matching: exact amount+date, OCR, date range, fuzzy amount"/>
            </xpath>
        </field>
    </record>

</odoo>
