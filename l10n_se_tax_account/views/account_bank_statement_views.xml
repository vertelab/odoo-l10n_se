<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Bank statement form: add SKV info -->
    <record id="view_bank_statement_form" model="ir.ui.view">
      <field name="name">account.bank.statement.form.tax.account</field>
      <field name="model">account.bank.statement</field>
      <field name="inherit_id"
             ref="account.view_bank_statement_form"/>
      <field name="arch" type="xml">
        <field name="name" position="after">
          <field name="skv_ocr_number"
                 invisible="not skv_ocr_number"/>
          <field name="skv_last_fetch"
                 invisible="not skv_ocr_number"/>
        </field>
      </field>
    </record>

  </data>
</odoo>
