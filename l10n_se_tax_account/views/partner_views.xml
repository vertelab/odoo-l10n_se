<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Partner form: simplified SKV tab -->
    <record id="view_partner_form" model="ir.ui.view">
      <field name="name">res.partner.form.tax.account</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="priority">25</field>
      <field name="arch" type="xml">

        <field name="category_id" position="after">
          <field name="enable_skatteverket_api"/>
        </field>

        <page name="internal_notes" position="after">
          <page name="skatteverket_api" string="Skatteverket API"
                invisible="not enable_skatteverket_api">
            <group>
              <group>
                <field name="certificate"
                       widget="binary"
                       filename="certificate_filename"/>
                <field name="certificate_pin"/>
                <field name="oauth_client_id"/>
                <field name="oauth_secret"/>
              </group>
              <group>
                <field name="authorization_code" readonly="1"/>
                <field name="recived_token_on" readonly="1"/>
                <field name="access_token" readonly="1"
                       password="True"/>
              </group>
            </group>
          </page>
        </page>

      </field>
    </record>

  </data>
</odoo>
