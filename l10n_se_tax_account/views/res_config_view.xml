<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- SKV API settings on Accounting Configuration -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.tax.account</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id"
             ref="account.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//block[@id='account_digitalization']"
               position="after">
          <block title="Tax Account (Skatteverket)" id="skv_tax_account_block">
            <setting id="skv_test_mode_setting"
                     string="Skatteverket API"
                     help="Configure the connection to Skatteverket's Tax Account API for automatic transaction fetching and reconciliation.">
              <div class="content-group" id="skv_settings">
                <field name="skv_test_mode" invisible="1"/>
                <field name="skv_auth_method" invisible="1"/>
                <div class="row mt8">
                  <label for="skv_api_url"
                         string="Tax Account API URL"
                         class="col-lg-4 o_light_label"/>
                  <field name="skv_api_url"
                         placeholder="https://api.skatteverket.se/skattekonto/v2"/>
                </div>
                <div class="row mt8">
                  <label for="skv_auth_url"
                         string="Auth URL"
                         class="col-lg-4 o_light_label"/>
                  <field name="skv_auth_url"
                         placeholder="https://peroauth2.skatteverket.se/oauth2/v1/org/authorize"/>
                </div>
                <div class="row mt8">
                  <label for="skv_token_url"
                         string="Token URL"
                         class="col-lg-4 o_light_label"/>
                  <field name="skv_token_url"
                         placeholder="https://peroauth2.skatteverket.se/oauth2/v1/org/token"/>
                </div>
              </div>
            </setting>
            <setting id="skv_match_tolerance_setting"
                     string="Auto-match Tolerance"
                     help="Number of days difference allowed when auto-matching tax account transactions with booked entries.">
              <div class="content-group">
                <div class="row mt8">
                  <label for="skv_match_tolerance_days"
                         string="Tolerance"
                         class="col-lg-4 o_light_label"/>
                  <field name="skv_match_tolerance_days"/> days
                </div>
              </div>
            </setting>
          </block>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
