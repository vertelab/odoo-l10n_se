<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_skatteverket_form" model="ir.ui.view">
            <field name="name">res.partner.skatteverket.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="%(l10n_se_skatteverket_api.action_open_skv_partner)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-lock"
                            attrs="{'invisible': [('enable_skatteverket_api', '=', False)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="access_token" widget="text" class="o_stat_text"/>
                            </span>
                            <span class="o_stat_text">SKV API</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="after">
                    <group string="Skatteverket API" attrs="{'invisible': [('enable_skatteverket_api', '=', False)]}">
                        <field name="enable_skatteverket_api"/>
                        <field name="certificate" filename="certificate" password="certificate_pin"/>
                        <field name="certificate_pin"/>
                        <field name="oauth_client_id"/>
                        <field name="oauth_secret"/>
                        <field name="access_token" readonly="1"/>
                        <field name="recived_token_on" readonly="1"/>
                        <field name="expires_in" readonly="1"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
