    <!-- Q1 -->
    <record id="slide_s4_05_q1" model="slide.question">
        <field name="question">Vilken betaltyp skapar ett verifikat direkt vid betalningstillfället?</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_s4_05"/>
    </record>
    <record id="slide_s4_05_q1_a1" model="slide.answer">
        <field name="text_value">IBAN-betalning</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! IBAN skapar inget verifikat förrän avstämning.</field>
        <field name="question_id" ref="slide_s4_05_q1"/>
    </record>
    <record id="slide_s4_05_q1_a2" model="slide.answer">
        <field name="text_value">Autogiro</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Autogiro väntar också på bankavstämning.</field>
        <field name="question_id" ref="slide_s4_05_q1"/>
    </record>
    <record id="slide_s4_05_q1_a3" model="slide.answer">
        <field name="text_value">Manuell betalning</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Manuell betalning skapar och bokför verifikat direkt.</field>
        <field name="question_id" ref="slide_s4_05_q1"/>
    </record>

    <!-- Q2 -->
    <record id="slide_s4_05_q2" model="slide.question">
