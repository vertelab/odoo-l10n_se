<section class="s_cover parallax o_cc o_cc5 pt200 pb200" data-scroll-background-ratio="1">
    <span class="s_parallax_bg oe_img_bg" style="background-color: #2d3748;"/>
    <div class="container">
        <h1 class="display-3-fs" style="text-align: center;">Varför olika betalsätt?</h1>
