    </record>

    <!-- Q1 -->
    <record id="slide_s5_04_q1" model="slide.question">
        <field name="question">Var aktiverar man pending_until_reconciliation för en betalmetod?</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_s5_04"/>
    </record>
    <record id="slide_s5_04_q1_a1" model="slide.answer">
        <field name="text_value">Redovisning > Konfiguration > Betalmetoder</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Pending-flaggan finns på betalmetoden.</field>
        <field name="question_id" ref="slide_s5_04_q1"/>
    </record>
    <record id="slide_s5_04_q1_a2" model="slide.answer">
        <field name="text_value">Redovisning > Konfiguration > Betalningssätt</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Betalsättet ärver från betalmetoden.</field>
        <field name="question_id" ref="slide_s5_04_q1"/>
    </record>
    <record id="slide_s5_04_q1_a3" model="slide.answer">
        <field name="text_value">Redovisning > Inställningar</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Delvis rätt! Där finns en global inställning, men per betalmetod görs det i Betalmetoder.</field>
        <field name="question_id" ref="slide_s5_04_q1"/>
    </record>

    <!-- Q2 -->
    <record id="slide_s5_04_q2" model="slide.question">
        <field name="question">Vad gör Supplier Payment Mode på leverantören?</field>
        <field name="sequence">2</field>
        <field name="slide_id" ref="slide_s5_04"/>
    </record>
    <record id="slide_s5_04_q2_a1" model="slide.answer">
        <field name="text_value">Auto-fyller betalsättet på nya fakturor</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Supplier Payment Mode automatiskt föreslås på nya fakturor.</field>
        <field name="question_id" ref="slide_s5_04_q2"/>
    </record>
    <record id="slide_s5_04_q2_a2" model="slide.answer">
        <field name="text_value">Skapar automatiskt betalorder vid fakturering</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Det gör den inte — betalorder skapas manuellt.</field>
        <field name="question_id" ref="slide_s5_04_q2"/>
    </record>
    <record id="slide_s5_04_q2_a3" model="slide.answer">
        <field name="text_value">Betalar fakturan automatiskt</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Supplier Payment Mode påverkar bara vilket betalsätt som föreslås.</field>
        <field name="question_id" ref="slide_s5_04_q2"/>
    </record>

    <!-- Q3 -->
    <record id="slide_s5_04_q3" model="slide.question">
        <field name="question">Vilket BAS-konto används för Bankgiro-betalningar?</field>
        <field name="sequence">3</field>
        <field name="slide_id" ref="slide_s5_04"/>
    </record>
    <record id="slide_s5_04_q3_a1" model="slide.answer">
        <field name="text_value">1930 — Företagskonto</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! 1930 är för vanliga bankkonton.</field>
        <field name="question_id" ref="slide_s5_04_q3"/>
    </record>
    <record id="slide_s5_04_q3_a2" model="slide.answer">
        <field name="text_value">1940 — Övriga bankkonton (Bankgiro)</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Bankgiro använder konto 1940.</field>
        <field name="question_id" ref="slide_s5_04_q3"/>
    </record>
    <record id="slide_s5_04_q3_a3" model="slide.answer">
        <field name="text_value">2441 — Leverantörsskulder</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! 2441 är för leverantörsskulder, inte bankkontot.</field>
        <field name="question_id" ref="slide_s5_04_q3"/>
    </record>

    <!-- Q4 -->
    <record id="slide_s5_04_q4" model="slide.question">
        <field name="question">Vad måste vara ifyllt på bankjournalen för att bankavstämning ska fungera?</field>
        <field name="sequence">4</field>
        <field name="slide_id" ref="slide_s5_04"/>
    </record>
    <record id="slide_s5_04_q4_a1" model="slide.answer">
        <field name="text_value">Bankkonto (bank_account_id)</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Delvis rätt! Men även Suspense Account krävs.</field>
        <field name="question_id" ref="slide_s5_04_q4"/>
    </record>
    <record id="slide_s5_04_q4_a2" model="slide.answer">
        <field name="text_value">Suspense Account (observationskonto)</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Suspense Account används som mellanhand vid avstämning.</field>
        <field name="question_id" ref="slide_s5_04_q4"/>
    </record>
    <record id="slide_s5_04_q4_a3" model="slide.answer">
        <field name="text_value">Inget särskilt — Odoo skapar automatiskt</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Suspense Account måste konfigureras på journalen.</field>
        <field name="question_id" ref="slide_s5_04_q4"/>
    </record>

    <!-- Q5 -->
    <record id="slide_s5_04_q5" model="slide.question">
        <field name="question">En leverantör har både IBAN och Bankgiro. Hur hanterar man det?</field>
        <field name="sequence">5</field>
        <field name="slide_id" ref="slide_s5_04"/>
    </record>
    <record id="slide_s5_04_q5_a1" model="slide.answer">
        <field name="text_value">Man väljer ett som Supplier Payment Mode och ändrar per faktura vid behov</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Supplier Payment Mode är standard — du kan alltid ändra per faktura.</field>
        <field name="question_id" ref="slide_s5_04_q5"/>
    </record>
    <record id="slide_s5_04_q5_a2" model="slide.answer">
        <field name="text_value">Man måste skapa två leverantörskonton</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! En leverantör kan ha flera bankkonton och betalsätt.</field>
        <field name="question_id" ref="slide_s5_04_q5"/>
    </record>
    <record id="slide_s5_04_q5_a3" model="slide.answer">
        <field name="text_value">Bankgiro är alltid standard — IBAN måste väljas manuellt</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Du väljer själv vilket som ska vara standard.</field>
        <field name="question_id" ref="slide_s5_04_q5"/>
    </record>

    </data>
