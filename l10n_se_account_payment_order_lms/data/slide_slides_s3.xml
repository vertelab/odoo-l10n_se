        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! I pending-mode kvittas skulden inte vid uppladdning.</field>
        <field name="question_id" ref="slide_s3_04_q1"/>
    </record>
    <record id="slide_s3_04_q1_a2" model="slide.answer">
        <field name="text_value">Skulden finns kvar — väntar på bankavstämning</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Leverantörsskulden finns kvar tills bankrad matchas.</field>
        <field name="question_id" ref="slide_s3_04_q1"/>
    </record>
    <record id="slide_s3_04_q1_a3" model="slide.answer">
