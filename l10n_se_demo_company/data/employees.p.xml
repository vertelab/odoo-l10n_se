        <!-- Employees                                                    -->
        <!--                                                              -->
        <!-- The seven employees from the payroll demo (Tiichri). Names,  -->
        <!-- personal numbers and addresses are kept — they are already   -->
        <!-- invented. Employment periods follow the timeline in          -->
        <!-- l10n-se-demo-datasets design D-timeline:                     -->
        <!--                                                              -->
        <!--   2024  seven employees, one hired in Q3                     -->
        <!--   2025  one hired in Q1, one leaves in Q4 (retirement)       -->
        <!--   2026  one leaves in Q2 (resignation)                       -->
        <!--   2027  seven employees                                      -->
        <!--                                                              -->
        <!-- Contracts are not created here — they belong to the payroll  -->
        <!-- demo, which owns the wage data. This module only guarantees   -->
        <!-- that the people exist and have a bank account.               -->
        <!-- ============================================================ -->

        <record id="work_location_main" model="hr.work.location">
            <field name="name">Rosersberg, HK</field>
            <field name="address_id" ref="company_partner"/>
            <field name="company_id" ref="company"/>
            <field name="location_type">office</field>
        </record>

        <record id="job_president" model="hr.job">
            <field name="name">VD och försäljningschef</field>
            <field name="company_id" ref="company"/>
        </record>
