<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bokslut checklist stages (project.task.type) -->
    <record id="bokslut_stage_todo" model="project.task.type">
        <field name="name">Att göra</field>
        <field name="sequence">1</field>
        <field name="fold" eval="False"/>
    </record>
    <record id="bokslut_stage_ongoing" model="project.task.type">
        <field name="name">Pågående</field>
        <field name="sequence">2</field>
        <field name="fold" eval="False"/>
    </record>
    <record id="bokslut_stage_review" model="project.task.type">
        <field name="name">Granskning</field>
        <field name="sequence">3</field>
        <field name="fold" eval="False"/>
    </record>
    <record id="bokslut_stage_done" model="project.task.type">
        <field name="name">Klar</field>
        <field name="sequence">4</field>
        <field name="fold" eval="True"/>
    </record>
    <record id="bokslut_stage_na" model="project.task.type">
        <field name="name">Ej tillämplig</field>
        <field name="sequence">5</field>
        <field name="fold" eval="True"/>
    </record>
</odoo>
