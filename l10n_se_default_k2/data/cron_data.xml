<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Kor kontoplansappliceringen en gang efter uppstart.

            post_init_hook racker inte: vid init rullar Odoo tillbaka
            konton som skapas via try_loading. Cronen kor i en egen
            transaktion och stanger av sig sjalv efterat.
        -->
        <record id="cron_apply_default_chart" model="ir.cron">
            <field name="name">l10n_se_default_k2: applicera K2-kontoplanen</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._l10n_se_apply_default_k2_chart()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
