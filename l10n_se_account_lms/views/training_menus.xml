<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Main Training Menu.

        account_accountant_ce replaces the core "Invoicing" root menu
        (account.menu_finance) with its own "Accounting" root
        (account_accountant_ce.menu_accounting) and moves the standard
        accounting submenus under it. account.menu_finance is then left in
        place as an empty shell, but Odoo still renders it as soon as
        anything is parented to it - which is exactly what happened here:
        the training menu kept the old root alive, so the user saw both
        "Invoicing" and "Accounting" pointing at the same content.

        Parent the training menu under the Accounting root instead. The
        dependency on account_accountant_ce guarantees that root exists.
    -->
    <record id="menu_training_root" model="ir.ui.menu">
        <field name="name">Swedish Accounting Training</field>
        <field name="parent_id" ref="account_accountant_ce.menu_accounting"/>
        <field name="sequence">95</field>
    </record>

    <menuitem id="menu_training_categories"
              name="Training Categories"
              parent="menu_training_root"
              action="action_training_category"
              sequence="10"/>

    <menuitem id="menu_training_lessons"
              name="All Lessons"
              parent="menu_training_root"
              action="action_training_lesson"
              sequence="20"/>

    <menuitem id="menu_quiz"
              name="Diagnostic Quizzes"
              parent="menu_training_root"
              action="action_quiz_attempt"
              sequence="30"/>

</odoo>
