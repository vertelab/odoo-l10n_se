<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Main Training Menu.

        It belongs under the accounting root, but which root that is has
        changed: account_accountant_ce used to create its own
        (account_accountant_ce.menu_accounting) and now renames the core
        account.menu_finance instead. The old root is deleted by
        account_accountant_ce, so parenting here must use the core menu —
        otherwise this module recreates the very menu that was removed, and
        the user sees two "Accounting" apps again.

        account_accountant_ce is a hard dependency, so account.menu_finance is
        guaranteed to exist and to carry the "Accounting" name.
    -->
    <record id="menu_training_root" model="ir.ui.menu">
        <field name="name">Swedish Accounting Training</field>
        <field name="parent_id" ref="account.menu_finance"/>
        <field name="sequence">95</field>
    </record>

    <menuitem id="menu_training_categories"
              name="Training Categories"
              parent="menu_training_root"
              action="action_training_category"
              sequence="10"/>

    <menuitem id="menu_training_lessons"
              name="All Lessons"
              parent="menu_training_root"
              action="action_training_lesson"
              sequence="20"/>

    <menuitem id="menu_quiz"
              name="Diagnostic Quizzes"
              parent="menu_training_root"
              action="action_quiz_attempt"
              sequence="30"/>

</odoo>
