<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category Kanban -->
    <record id="view_training_category_kanban" model="ir.ui.view">
        <field name="name">l10n_se.training.category.kanban</field>
        <field name="model">l10n_se.training.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="color"/>
                <field name="lesson_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <t t-if="record.description.raw_value">
                                    <div class="text-muted small"
                                         t-out="record.description.raw_value"/>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge"><t t-esc="record.lesson_count.value"/> lessons</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Category Tree -->
    <record id="view_training_category_tree" model="ir.ui.view">
        <field name="name">l10n_se.training.category.tree</field>
        <field name="model">l10n_se.training.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="lesson_count"/>
            </tree>
        </field>
    </record>

    <!-- Category Form -->
    <record id="view_training_category_form" model="ir.ui.view">
        <field name="name">l10n_se.training.category.form</field>
        <field name="model">l10n_se.training.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Category Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="icon" widget="radio"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="skv_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Lessons">
                            <field name="lesson_ids" context="{'default_category_id': id}">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="difficulty" widget="badge"
                                           decoration-success="difficulty == 'beginner'"
                                           decoration-warning="difficulty == 'intermediate'"
                                           decoration-danger="difficulty == 'advanced'"/>
                                    <field name="estimated_minutes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Action -->
    <record id="action_training_category" model="ir.actions.act_window">
        <field name="name">Training Categories</field>
        <field name="res_model">l10n_se.training.category</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

</odoo>
