<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Resultaträkning instance -->
        <record id="mis_report_instance_resultatrakning" model="mis.report.instance">
            <field name="name">Resultaträkning</field>
            <field name="report_id" ref="l10n_se_mis.report_rr"/>
            <field name="target_move">posted</field>
            <field name="period_ids" eval="[
                (0, 0, {
                    'name': 'Current year',
                    'mode': 'relative',
                    'type': 'y',
                    'offset': 0,
                    'duration': 1,
                    'sequence': 1,
                }),
                (0, 0, {
                    'name': 'Previous year',
                    'mode': 'relative',
                    'type': 'y',
                    'offset': -1,
                    'duration': 1,
                    'sequence': 2,
                }),
            ]"/>
        </record>

        <!-- Resultaträkning (kompakt) instance -->
        <record id="mis_report_instance_resultatrakning_kompakt" model="mis.report.instance">
            <field name="name">Resultaträkning (kompakt)</field>
            <field name="report_id" ref="l10n_se_mis.report_rr_compact"/>
            <field name="target_move">posted</field>
            <field name="no_auto_expand_accounts">True</field>
            <field name="period_ids" eval="[
                (0, 0, {
                    'name': 'Current year',
                    'mode': 'relative',
                    'type': 'y',
                    'offset': 0,
                    'duration': 1,
                    'sequence': 1,
                }),
                (0, 0, {
                    'name': 'Previous year',
                    'mode': 'relative',
                    'type': 'y',
                    'offset': -1,
                    'duration': 1,
                    'sequence': 2,
                }),
            ]"/>
        </record>
        <!-- Balansräkning instance: IB / Förändringar / UB -->
        <record id="mis_report_instance_balansrakning" model="mis.report.instance">
            <field name="name">Balansräkning</field>
            <field name="report_id" ref="l10n_se_mis.report_br"/>
            <field name="target_move">posted</field>
        </record>

        <!-- IB: Ingående balans (föregående årsskifte) -->
        <record id="mis_report_instance_balansrakning_period_ib" model="mis.report.instance.period">
            <field name="name">IB</field>
            <field name="report_instance_id" ref="mis_report_instance_balansrakning"/>
            <field name="mode">relative</field>
            <field name="type">y</field>
            <field name="offset">-1</field>
            <field name="duration">1</field>
            <field name="sequence">1</field>
        </record>

        <!-- UB: Utgående balans (innevarande årsskifte) -->
        <record id="mis_report_instance_balansrakning_period_ub" model="mis.report.instance.period">
            <field name="name">UB</field>
            <field name="report_instance_id" ref="mis_report_instance_balansrakning"/>
            <field name="mode">relative</field>
            <field name="type">y</field>
            <field name="offset">0</field>
            <field name="duration">1</field>
            <field name="sequence">3</field>
        </record>

        <!-- Förändringar: UB - IB -->
        <record id="mis_report_instance_balansrakning_period_forandringar" model="mis.report.instance.period">
            <field name="name">Förändringar</field>
            <field name="report_instance_id" ref="mis_report_instance_balansrakning"/>
            <field name="mode">custom</field>
            <field name="source_cmpcol_from_id" ref="mis_report_instance_balansrakning_period_ib"/>
            <field name="source_cmpcol_to_id" ref="mis_report_instance_balansrakning_period_ub"/>
            <field name="sequence">2</field>
        </record>

        <!-- Balansräkning (kompakt) instance: IB / Förändringar / UB -->
        <record id="mis_report_instance_balansrakning_kompakt" model="mis.report.instance">
            <field name="name">Balansräkning (kompakt)</field>
            <field name="report_id" ref="l10n_se_mis.report_br"/>
            <field name="target_move">posted</field>
            <field name="no_auto_expand_accounts">True</field>
        </record>

        <record id="mis_report_instance_balansrakning_kompakt_period_ib" model="mis.report.instance.period">
            <field name="name">IB</field>
            <field name="report_instance_id" ref="mis_report_instance_balansrakning_kompakt"/>
            <field name="mode">relative</field>
            <field name="type">y</field>
            <field name="offset">-1</field>
            <field name="duration">1</field>
            <field name="sequence">1</field>
        </record>

        <record id="mis_report_instance_balansrakning_kompakt_period_ub" model="mis.report.instance.period">
            <field name="name">UB</field>
            <field name="report_instance_id" ref="mis_report_instance_balansrakning_kompakt"/>
            <field name="mode">relative</field>
            <field name="type">y</field>
            <field name="offset">0</field>
            <field name="duration">1</field>
            <field name="sequence">3</field>
        </record>

        <record id="mis_report_instance_balansrakning_kompakt_period_forandringar" model="mis.report.instance.period">
            <field name="name">Förändringar</field>
            <field name="report_instance_id" ref="mis_report_instance_balansrakning_kompakt"/>
            <field name="mode">custom</field>
            <field name="source_cmpcol_from_id" ref="mis_report_instance_balansrakning_kompakt_period_ib"/>
            <field name="source_cmpcol_to_id" ref="mis_report_instance_balansrakning_kompakt_period_ub"/>
            <field name="sequence">2</field>
        </record>
    </data>
</odoo>
