                    <field name="label">balance</field>
                    <field name="engine">account_codes</field>
                    <field name="formula">-3000,3001,3002,3003,3510,3511,3518,3520,3540,3550,3560,3561,3562,3563,3570,3590,3600,3610,3611,3612,3613,3619,3620,3730,3731,3732,3740</field>
