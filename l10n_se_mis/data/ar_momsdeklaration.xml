                    <field name="engine">domain</field>
                    <field name="formula">["&amp;", ["account_id.code", "=like", "2614%"], "|", "|", ["tax_line_id.name", "=", "TFEU"], ["tax_line_id.name", "=", "VFEU"], ["tax_line_id.name", "=", "TFFU"]]</field>
