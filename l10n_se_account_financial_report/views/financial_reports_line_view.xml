<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="financial_reports_list_view" model="ir.ui.view">
            <field name="name">financial.reports.list.view</field>
            <field name="model">financial.reports</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" string="Name" />
                    <field name="lines" string="Lines" />
                </list>
            </field>
        </record>

        <record id="financial_reports_form_view" model="ir.ui.view">
            <field name="name">financial.reports.form.view</field>
            <field name="model">financial.reports</field>
            <field name="arch" type="xml">
                <form string="Financial Reports Lines">
                    <header>
                        <button name="action_view_report" type="object" string="View Report" class="btn btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Name" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Filter">
                                <group>
                                    <group>
                                        <field name="date_picker"/>
                                        <field name="date"/>
                                    </group>
                                    <group>
                                        <field name="parent_state"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Lines">
                                 <field name="lines" string="Lines" />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="financial_reports_line_form_view" model="ir.ui.view">
            <field name="name">financial.reports.line.form.view</field>
            <field name="model">financial.reports.line</field>
            <field name="arch" type="xml">
                <form string="Financial Reports Lines">
                    <sheet>
                        <group>
                            <group>
                            <field name="name" string="Name" />
                            <field name="invert_value"/>
                            <field name="amount_type"/>
                            
                            </group>
                            <group string="Domains">
                            <field name="account_char_list" stirng="Domain Code" />
                            <field name="taxes_char_list" />
                            <field name="originator_tax_char_list" />
                            <field name="domain_expression"/>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>
        

        <record id="financial_reports_list_action" model="ir.actions.act_window">
            <field name="res_model">financial.reports</field>
            <field name="type">ir.actions.act_window</field>
            <field name="name">Financial Reports Action</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="financial_reports_list_view" />
        </record>

        <menuitem id="financial_reports_menu" parent="account.menu_finance_configuration" name="Report Generator" sequence="201" />
        <menuitem id="financial_reports_view_menu" parent="financial_reports_menu" name="Financial Reports" action="financial_reports_list_action" sequence="202" />

    </data>
</odoo>
