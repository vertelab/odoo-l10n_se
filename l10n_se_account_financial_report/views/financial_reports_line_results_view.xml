<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="financial_reports_line_results_list_view" model="ir.ui.view">
        <field name="name">financial.reports.line.results.list.view</field>
        <field name="model">financial.reports.line.results</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Name" />
                <field name="report_line_id"/>
                <field name="result" />
                <field name="domain" optional="hide"/>
                <button name="get_line_action" string="Show Lines" type="object"/>
            </list>
        </field>
    </record>

    <record id="financial_reports_line_results_list_action" model="ir.actions.act_window">
        <field name="res_model">financial.reports.line.results</field>
        <field name="type">ir.actions.act_window</field>
        <field name="name">Financial Reports Line Results</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="financial_reports_line_results_list_view" />
    </record>

</odoo>

