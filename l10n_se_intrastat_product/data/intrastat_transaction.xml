        <!-- Update base records with Swedish descriptions (overlapping codes) -->
        <record id="intrastat_product.intrastat_transaction_11" model="intrastat.transaction">
            <field name="description">Köp/försäljning (direkthandel) — Direkt köp eller försäljning av varor</field>
        </record>

        <record id="intrastat_product.intrastat_transaction_21" model="intrastat.transaction">
            <field name="description">Retur av varor — Återsändning av varor som tidigare rapporterats</field>
        </record>

        <record id="intrastat_product.intrastat_transaction_31" model="intrastat.transaction">
