        </record>

        <record id="intrastat_product.intrastat_transaction_51" model="intrastat.transaction">
            <field name="description">Varor efter bearbetning/reparation (inkommande) — Varor som returneras efter bearbetning eller reparation</field>
        </record>

        <record id="intrastat_product.intrastat_transaction_71" model="intrastat.transaction">
            <field name="description">Bygg- och anläggningsarbeten — Varor för bygg- och anläggningsarbeten</field>
        </record>

        <!-- Swedish-specific transaction codes -->
        <record id="intrastat_transaction_61_se" model="intrastat.transaction">
            <field name="code">61</field>
