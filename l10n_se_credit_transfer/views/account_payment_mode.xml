<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_mode_form_se" model="ir.ui.view">
        <field name="name">l10n_se.credit.transfer.payment.mode.form</field>
        <field name="model">account.payment.mode</field>
        <field
            name="inherit_id"
            ref="account_banking_pain_base.account_payment_mode_form"
        />
        <field name="arch" type="xml">
            <field name="initiating_party_scheme" position="after">
                <separator string="Swedish Credit Transfer" />
                <field
                    name="se_initiating_party_identifier"
                    invisible="payment_method_id.code != 'se_credit_transfer'"
                    required="payment_method_id.code == 'se_credit_transfer'"
                />
                <field
                    name="se_initiating_party_scheme"
                    invisible="payment_method_id.code != 'se_credit_transfer'"
                />
                <field
                    name="se_corporate_pay_agreement_id"
                    invisible="payment_method_id.code != 'se_credit_transfer'"
                />
            </field>
        </field>
    </record>
</odoo>
