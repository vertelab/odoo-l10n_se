<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- The two locale-specific date range types.

             Fiscal Year and Month are generic and live in
             account_fiscal_year_vrtl, which this module depends on. The types
             below carry Swedish naming expressions, so they belong here.

             noupdate="1": an administrator may rename a type; a module
             upgrade must not overwrite that.
        -->
        <record id="date_range_type_quarter" model="date.range.type">
            <field name="name">Quarter</field>
            <field name="unit_of_time">1</field>
            <field name="duration_count">3</field>
            <field name="allow_overlap" eval="False"/>
            <field name="name_expr">'Q%s-%s' % (date_start.strftime('%y'), ((date_start.month - 1) // 3 + 1))</field>
        </record>

        <record id="date_range_type_week" model="date.range.type">
            <field name="name">Week</field>
            <field name="unit_of_time">2</field>
            <field name="duration_count">1</field>
            <field name="allow_overlap" eval="False"/>
            <field name="name_expr">'W%s' % date_start.strftime('%y%V')</field>
        </record>
    </data>
</odoo>
