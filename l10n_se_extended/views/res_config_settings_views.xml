<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_digitization" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.digitization</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_digitalization']" position="inside">
                <setting id="document_digitization_ai_setting"
                    help="Digitize your PDF or scanned documents with AI-powered invoice processing"
                    documentation="/applications/finance/accounting/payables/supplier_bills/invoice_digitization.html">
                    <field name="module_account_invoice_ai" widget="upgrade_boolean"/>
                    <div id="msg_account_invoice_ai" class="content-group" invisible="not module_account_invoice_ai">
                        <div class="text-warning mt16 mb4">
                            Save this page and come back here to set up the feature.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
