<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         Swedish Accounting — Comprehensive Settings Page
         11 sections injected into Account settings.
         ================================================================== -->
    <record id="res_config_settings_view_form_swedish_accounting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.swedish.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">

                <!-- ====== Header ====== -->
                <block title="Swedish Accounting" id="swedish_accounting_header">
                    <div class="text-muted mb16">
                        Configure your Swedish accounting setup. Enable features —
                        modules are installed automatically when you save.
                    </div>
                </block>

                <!-- ====== 1. Standardrapporter ====== -->
                <block title="Standardrapporter" id="swedish_financial_reports">
                    <div class="text-muted mb8">
                        Balans och resultaträkning m.fl.
                    </div>
                    <setting id="account_financial_report_setting"
                        string="Financial Reports"
                        help="General Ledger, Trial Balance, Aged Partner Balance, Journal Ledger, Open Items.">
                        <field name="module_account_financial_report"/>
                    </setting>
                    <setting id="l10n_se_account_financial_report_setting"
                        string="Swedish Report Templates"
                        help="Swedish-styled Balance Sheet and Income Statement.">
                        <field name="module_l10n_se_account_financial_report"/>
                    </setting>
                    <setting id="l10n_se_mis_setting"
                        string="MIS Builder"
                        help="Pre-built MIS report templates for Swedish accounting.">
                        <field name="module_l10n_se_mis"/>
                    </setting>
                    <setting id="mis_report_package_setting"
                        string="Report Package"
                        help="Select which MIS report package to install — balansräkning, resultaträkning, kassaflödesanalys. K2/K3/Kommun."
                        invisible="not module_l10n_se_mis">
                        <field name="mis_report_package"/>
                    </setting>
                    <setting id="mis_builder_cash_flow_setting"
                        string="Cash Flow Statement"
                        help="Cash flow statement for MIS Builder.">
                        <field name="module_mis_builder_cash_flow"/>
                    </setting>
                </block>

                <!-- ====== 2. Bank &amp; Payments ====== -->
                <block title="Bank &amp; Payments" id="swedish_bank_payments">
                    <setting id="account_payment_order_setting"
                        string="Payment Orders (Bankgiro/Plusgiro/SEPA)"
                        help="Create payment orders for SEPA, Bankgiro and Plusgiro.">
                        <field name="module_account_payment_order"/>
                    </setting>
                    <setting id="account_payment_order_sepa_seb_setting"
                        string="SEB SEPA Fix"
                        help="SEB-specific SEPA payment format.">
                        <field name="module_account_payment_order_sepa_seb"/>
                    </setting>
                    <setting id="account_payment_order_autogiro_setting"
                        string="Autogiro (Direct Debit)"
                        help="Swedish Autogiro direct debit.">
                        <field name="module_account_payment_order_autogiro"/>
                    </setting>
                    <setting id="account_enablebanking_setting"
                        string="Auto Bank Sync (PSD2)"
                        help="Automatic bank sync via Enable Banking API.">
                        <field name="module_account_enablebanking"/>
                    </setting>
                    <setting id="l10n_se_mynt_setting"
                        string="Mynt Corporate Cards"
                        help="Integration with Mynt corporate cards.">
                        <field name="module_l10n_se_mynt"/>
                    </setting>
                    <setting id="account_fortnox_setting"
                        string="Fortnox Integration"
                        help="Data migration and sync with Fortnox.">
                        <field name="module_account_fortnox"/>
                    </setting>
                    <setting id="l10n_se_account_bank_statement_import_setting"
                        string="Swedish Bank Statement Import"
                        help="Import bank statements in Swedish formats (Bankgiro, BGMax).">
                        <field name="module_l10n_se_account_bank_statement_import"/>
                    </setting>
                    <setting id="l10n_se_ocr_reconcile_setting"
                        string="OCR Reconciliation"
                        help="Automatic OCR-based reconciliation for Swedish payment references.">
                        <field name="module_l10n_se_ocr_reconcile"/>
                    </setting>
                    <div class="content-group mt8" invisible="not module_l10n_se_ocr_reconcile">
                        <a href="#" class="oe_link" role="button"
                            name="%(account.action_account_reconcile_model)d"
                            type="action">Configure Reconciliation Rules</a>
                    </div>
                </block>

                <!-- ====== 3. Supplier Invoices ====== -->
                <block title="Supplier Invoices" id="swedish_supplier_invoices">
                    <setting id="document_digitization_ai_setting"
                        string="AI Invoice Processing"
                        help="Digitize your PDF or scanned documents with AI-powered invoice processing."
                        documentation="/applications/finance/accounting/payables/supplier_bills/invoice_digitization.html">
                        <field name="module_account_invoice_ai"/>
                        <div id="msg_account_invoice_ai" class="content-group" invisible="not module_account_invoice_ai">
                            <div class="text-warning mt16 mb4">
                                Save this page and come back here to set up the feature.
                            </div>
                        </div>
                    </setting>
                    <setting id="account_invoice_ai_3way_match_setting"
                        string="AI 3-Way Match"
                        help="AI-powered PO/receipt/invoice matching. Requires AI Invoice Processing.">
                        <field name="module_account_invoice_ai_3way_match"/>
                    </setting>
                    <setting id="account_3way_match_ce_setting"
                        string="Manual 3-Way Match"
                        help="Manual purchase order / receipt / invoice matching.">
                        <field name="module_account_3way_match_ce"/>
                    </setting>
                    <setting id="account_import_excel_setting"
                        string="Excel Invoice Import"
                        help="Mass import invoices from Excel.">
                        <field name="module_account_import_excel"/>
                    </setting>
                </block>

                <!-- ====== 4. Customer Invoices ====== -->
                <block title="Customer Invoices" id="swedish_customer_invoices">
                    <setting id="account_due_reminder_setting"
                        string="Payment Reminders"
                        help="Automated payment reminders for overdue invoices.">
                        <field name="module_account_due_reminder"/>
                    </setting>
                    <setting id="account_mass_invoice_generation_setting"
                        string="Mass Invoice Generation"
                        help="Generate invoices in bulk.">
                        <field name="module_account_mass_invoice_generation"/>
                    </setting>
                    <setting id="account_bulk_invoices_setting"
                        string="Bulk Invoice Operations"
                        help="Bulk operations (print, send, validate).">
                        <field name="module_account_bulk_invoices"/>
                    </setting>
                </block>

                <!-- ====== 5. Tax &amp; Authorities ====== -->
                <block title="Tax &amp; Authorities" id="swedish_tax">
                    <setting id="l10n_se_tax_report_setting"
                        string="Tax Reports &amp; SKV API"
                        help="VAT, AGD, periodic summary via Skatteverket API.">
                        <field name="module_l10n_se_tax_report"/>
                    </setting>
                    <setting id="l10n_se_tax_account_setting"
                        string="Tax Account Reconciliation"
                        help="Two-column tax account reconciliation vs Skatteverket API.">
                        <field name="module_l10n_se_tax_account"/>
                    </setting>
                    <setting id="l10n_se_agi_setting"
                        string="AGI (Individual Reporting)"
                        help="Monthly AGI to Skatteverket via API.">
                        <field name="module_l10n_se_agi"/>
                    </setting>
                    <setting id="l10n_se_intrastat_product_setting"
                        string="Intrastat (SCB)"
                        help="Intrastat reporting to SCB.">
                        <field name="module_l10n_se_intrastat_product"/>
                    </setting>
                    <setting id="l10n_se_tax_report_payment_order_setting"
                        string="Tax Payment Orders"
                        help="Payment orders for tax payments.">
                        <field name="module_l10n_se_tax_report_payment_order"/>
                    </setting>
                </block>

                <!-- ====== 6. Period &amp; Closing ====== -->
                <block title="Period &amp; Closing" id="swedish_period">
                    <setting id="account_fiscal_year_vrtl_setting"
                        string="Swedish Periods"
                        help="Swedish fiscal periods with closing controls.">
                        <field name="module_account_fiscal_year_vrtl"/>
                    </setting>
                    <setting id="account_closed_setting"
                        string="Period Lock"
                        help="Lock periods to prevent changes after closing.">
                        <field name="module_account_closed"/>
                    </setting>
                    <setting id="account_auto_reverse_vrtl_setting"
                        string="Auto-Reverse Entries"
                        help="Automatically reverse journal entries next period.">
                        <field name="module_account_auto_reverse_vrtl"/>
                    </setting>
                    <setting id="account_deferred_revenue_expenses_setting"
                        string="Deferred Revenue &amp; Expenses"
                        help="Automatic revenue/expense accruals.">
                        <field name="module_account_deferred_revenue_expenses"/>
                    </setting>
                    <setting id="account_inter_company_rules_ce_setting"
                        string="Inter-Company Rules"
                        help="Automatic inter-company transactions.">
                        <field name="module_account_inter_company_rules_ce"/>
                    </setting>
                </block>

                <!-- ====== 7. Year-End Closing ====== -->
                <block title="Year-End Closing" id="swedish_bokslut">
                    <setting id="l10n_se_bokslut_setting"
                        string="Year-End Closing"
                        help="Closing checklist, tax calculation, adjustments, annual report.">
                        <field name="module_l10n_se_bokslut"/>
                    </setting>
                </block>

                <!-- ====== 8. Budget &amp; Forecast ====== -->
                <block title="Budget &amp; Forecast" id="swedish_budget">
                    <setting id="account_mis_budget_setting"
                        string="MIS Budget Management"
                        help="MIS-based budgets with budget vs actual.">
                        <field name="module_account_mis_budget"/>
                    </setting>
                    <setting id="account_mis_budget_forecast_setting"
                        string="Dynamic Forecast"
                        help="Dynamic forecast replacing budget with actuals.">
                        <field name="module_account_mis_budget_forecast"/>
                    </setting>
                    <setting id="account_budget_analytic_account_setting"
                        string="Budget per Analytic Account"
                        help="Budgets per project/department.">
                        <field name="module_account_budget_analytic_account"/>
                    </setting>
                </block>

                <!-- ====== 9. Assets ====== -->
                <block title="Assets" id="swedish_assets">
                    <setting id="account_asset_change_setting"
                        string="Asset Management"
                        help="Extended asset management with change tracking.">
                        <field name="module_account_asset_change"/>
                    </setting>
                    <setting id="account_asset_lot_stock_setting"
                        string="Asset Lot/Serial Tracking"
                        help="Track assets by lot/serial number.">
                        <field name="module_account_asset_lot_stock"/>
                    </setting>
                    <setting id="account_asset_management_grant_setting"
                        string="Asset Grants"
                        help="Grants and subsidies for assets.">
                        <field name="module_account_asset_management_grant"/>
                    </setting>
                    <setting id="account_loan_template_setting"
                        string="Loan Management"
                        help="Loan templates and accounting.">
                        <field name="module_account_loan_template"/>
                    </setting>
                </block>

                <!-- ====== 10. SIE &amp; Migration ====== -->
                <block title="SIE &amp; Migration" id="swedish_sie">
                    <setting id="l10n_se_sie_setting"
                        string="SIE Import/Export (Full)"
                        help="Full SIE4 import/export with dimensions.">
                        <field name="module_l10n_se_sie"/>
                    </setting>
                    <setting id="l10n_se_sie_minimal_setting"
                        string="SIE Import (Minimal)"
                        help="Lightweight SIE import for accounts and balances.">
                        <field name="module_l10n_se_sie_minimal"/>
                    </setting>
                </block>

                <!-- ====== 11. Document Management ====== -->
                <block title="Document Management" id="swedish_documents">
                    <setting id="account_attachment_directory_setting"
                        string="Document Directory"
                        help="Organize documents in structured directories.">
                        <field name="module_account_attachment_directory"/>
                    </setting>
                    <setting id="account_move_directory_setting"
                        string="Journal Entry Directory"
                        help="Organize journal entry attachments.">
                        <field name="module_account_move_directory"/>
                    </setting>
                </block>

            </xpath>
        </field>
    </record>

    <!-- Hide VAT Report from OCA Financial Reports menu when installed -->
    <record id="account_financial_report.menu_vat_report_wizard" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
