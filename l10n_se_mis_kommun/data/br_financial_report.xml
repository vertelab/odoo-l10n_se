        <record id="kpi_expr_report_br_OvrigaMateriellaAnlaggningstillgangar" model="mis.report.kpi.expression">
            <field name="kpi_id" ref="report_br_OvrigaMateriellaAnlaggningstillgangar"/>
            <field name="name">bal[]</field>
