        <record id="report_br_Anlaggningstillgangar" model="mis.report.kpi">
            <field name="report_id" ref="report_br"/>
            <field name="name">Anlaggningstillgangar</field>
            <field name="description">A. Anläggningstillgångar</field>
            <field name="style_id" ref="report_style_4"/>
            <field name="type">str</field>
            <field name="budgetable">False</field>
            <field name="sequence">1</field>
        </record>

        <!-- I. Immateriella anläggningstillgångar (10) -->
        <record id="report_br_ImmateriellaAnlaggningstillgangar" model="mis.report.kpi">
            <field name="report_id" ref="report_br"/>
            <field name="name">ImmateriellaAnlaggningstillgangar</field>
