            <field name="style_id" ref="report_style_5"/>
            <field name="type">num</field>
            <field name="budgetable">True</field>
            <field name="sequence">8</field>
        </record>

        <record id="kpi_expr_report_br_SummaAnlaggningstillgangar" model="mis.report.kpi.expression">
            <field name="kpi_id" ref="report_br_SummaAnlaggningstillgangar"/>
            <field name="name">ImmateriellaAnlaggningstillgangar + MarkByggnader + MaskinerInventarier + OvrigaMateriellaAnlaggningstillgangar + FinansiellaAnlaggningstillgangar</field>
        </record>

        <!-- B. Bidrag till infrastruktur (139) -->
        <record id="report_br_BidragInfrastruktur" model="mis.report.kpi">
            <field name="report_id" ref="report_br"/>
            <field name="name">BidragInfrastruktur</field>
