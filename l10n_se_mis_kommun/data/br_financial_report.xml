            <field name="budgetable">True</field>
        </record>

        <record id="kpi_expr_report_br_FinansiellaAnlaggningstillgangar" model="mis.report.kpi.expression">
            <field name="kpi_id" ref="report_br_FinansiellaAnlaggningstillgangar"/>
            <field name="name">bal[130%,131%,132%,133%,134%,135%,136%,137%,138%]</field>
        </record>

        <!-- Summa anläggningstillgångar -->
        <record id="report_br_SummaAnlaggningstillgangar" model="mis.report.kpi">
            <field name="report_id" ref="report_br"/>
            <field name="name">SummaAnlaggningstillgangar</field>
