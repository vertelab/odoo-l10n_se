        <record id="kpi_expr_report_br_ImmateriellaAnlaggningstillgangar" model="mis.report.kpi.expression">
            <field name="kpi_id" ref="report_br_ImmateriellaAnlaggningstillgangar"/>
            <field name="name">bal[10%]</field>
