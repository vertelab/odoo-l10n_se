        <!-- II. Materiella anläggningstillgångar -->
        <record id="report_br_MateriellaAnlaggningstillgangar" model="mis.report.kpi">
            <field name="report_id" ref="report_br"/>
            <field name="name">MateriellaAnlaggningstillgangar</field>
            <field name="description">II. Materiella anläggningstillgångar</field>
            <field name="style_id" ref="report_style_4"/>
            <field name="type">str</field>
            <field name="budgetable">False</field>
            <field name="sequence">3</field>
        </record>

        <!-- 1. Mark, byggnader och tekniska anläggningar (11) -->
        <record id="report_br_MarkByggnader" model="mis.report.kpi">
            <field name="report_id" ref="report_br"/>
            <field name="name">MarkByggnader</field>
