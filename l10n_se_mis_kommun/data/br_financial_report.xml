        <record id="kpi_expr_report_br_MarkByggnader" model="mis.report.kpi.expression">
            <field name="kpi_id" ref="report_br_MarkByggnader"/>
            <field name="name">bal[11%]</field>
        </record>

        <!-- 2. Maskiner och inventarier (12) -->
        <record id="report_br_MaskinerInventarier" model="mis.report.kpi">
